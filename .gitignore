# ProfitPilot — Git ignore rules
# ─────────────────────────────────────────────────────────────────────

# ── Secrets & credentials ─────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Database files (never commit user data) ───────────────────────────
.decision-lab/
*.sqlite3
*.sqlite
*.db
.backups/

# ── Python bytecode & caches ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────
venv/
.venv/
env/
ENV/
myenv/

# ── Node / JS (for test tooling only) ────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*

# ── OS / editor noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Test / coverage artifacts ─────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# ── Docker build cache ────────────────────────────────────────────────
.dockerignore
