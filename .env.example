# ProfitPilot — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to Git.

# ── Server ────────────────────────────────────────────────────────────
# Bind to 0.0.0.0 to accept public traffic (behind a reverse proxy only)
DECISION_LAB_HOST=0.0.0.0
DECISION_LAB_PORT=8765
# Set to 1 when running behind a trusted reverse proxy (Railway, Render, etc.)
DECISION_LAB_TRUST_PROXY=1
# Set to 1 to add Secure flag to session cookies (required on HTTPS)
DECISION_LAB_SECURE_COOKIE=1
# Path for SQLite data (ignored when DATABASE_URL is set)
DECISION_LAB_DATA=.decision-lab

# ── Database ──────────────────────────────────────────────────────────
# Leave empty to use SQLite (local dev only).
# Set to a PostgreSQL URL for production.
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Email / Password Reset ────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=ProfitPilot <noreply@example.com>
# Public base URL of your deployment (used in reset links)
APP_BASE_URL=https://your-domain.up.railway.app

# ── Google OAuth (optional) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.up.railway.app/auth/google/callback

# ── OpenAI AI review (optional) ───────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
DECISION_LAB_AI_MODEL=gpt-4o-mini
